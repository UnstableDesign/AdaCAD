2,0)","notes":"","draft_visible":true,"loom":null,"loom_settings":{"frames":8,"treadles":8,"epi":12,"ppi":12,"units":"in","type":"jacquard"},"render_colors":false,"scale":1},{"node_id":15418127,"draft_id":15418127,"ud_name":"","gen_name":"complex twill(2 2 3 3 5 5,0)","notes":"","draft_visible":true,"loom":null,"loom_settings":{"frames":8,"treadles":8,"epi":12,"ppi":12,"units":"in","type":"jacquard"},"render_colors":false,"scale":1}],"ops":[{"node_id":50274976,"name":"sine","params":[100,20,111],"inlets":[0]},{"node_id":80187288,"name":"rotate","params":[0,0],"inlets":[0]},{"node_id":55579623,"name":"directdrawdown","params":[],"inlets":[0,0]},{"node_id":94183213,"name":"sine","params":[100,20,63],"inlets":[0]},{"node_id":75418294,"name":"rotate","params":[0,0],"inlets":[0]},{"node_id":20447955,"name":"drawdown","params":[],"inlets":[0,0,0]},{"node_id":23846195,"name":"sawtooth","params":[100,18,7],"inlets":[0]},{"node_id":22698743,"name":"rotate","params":[0,0],"inlets":[0]},{"node_id":82129294,"name":"drawdown","params":[],"inlets":[0,0,0]},{"node_id":78159227,"name":"complex_twill","params":["2 2 3 3 2 2 3 3",0],"inlets":[]},{"node_id":47215112,"name":"shift","params":[8,5],"inlets":[0]},{"node_id":81385136,"name":"slope","params":[1,4],"inlets":[0]},{"node_id":28089486,"name":"overlay_multiple","params":[],"inlets":[0]},{"node_id":12103027,"name":"satin","params":[5,2,0],"inlets":[]},{"node_id":21016064,"name":"complex_twill","params":["2 2 3 3 5 5",0],"inlets":[]}],"notes":[{"id":94707081,"title":"Drawdown Experiments","text":"In this file, we experiment with different ways of using functions generated in adacad as threading, tieup, and treadling in the production of drawdowns. ","color":"#FFFF00","topleft":{"x":75,"y":210},"imageurl":null,"width":200,"height":200},{"id":36305512,"title":"Ensuring Good Structure","text":"As you can see the draft above as so many long floats that it wouldn't hold together well. To address that, we can overlay a satin structure","color":"#FFFF00","topleft":{"x":0,"y":3079.0960451977403},"imageurl":null,"width":200,"height":200},{"id":16024273,"title":"Using Tieup","text":"You can use the tieup in these experiments to bring more density to the pattern","color":"#FFFF00","topleft":{"x":3511.23595505618,"y":191.01123595505618},"imageurl":null,"width":200,"height":200},{"id":27217573,"title":"Sawtooth","text":"Sawtooth can creating things like M's and W's. Connecting this to a shift or slope operation can make interesting emergent patterns. ","color":"#FFFF00","topleft":{"x":8379.310344827587,"y":390.8045977011495},"imageurl":null,"width":200,"height":200}],"materials":[{"id":0,"name":"shuttle 0","stretch":1,"insert":true,"visible":true,"color":"#333333","thickness":100,"diameter":1,"type":0,"notes":"","rgb":{"r":51,"g":51,"b":51}},{"id":1,"name":"shuttle 1","stretch":1,"insert":true,"visible":true,"color":"#ffffff","thickness":100,"diameter":1,"type":0,"notes":"","rgb":{"r":255,"g":255,"b":255}},{"id":2,"name":"conductive","stretch":1,"insert":true,"visible":true,"color":"#ff4081","thickness":100,"diameter":1,"type":1,"notes":"","rgb":{"r":255,"g":64,"b":129}},{"id":3,"name":"Red Unmercerized 5/2 Cotton","stretch":1,"insert":true,"visible":true,"color":"#eb0404","thickness":100,"diameter":1,"type":0,"notes":"","rgb":{"r":235,"g":4,"b":4}},{"id":4,"name":"Lavender Unmercerized 5/2 Cotton","stretch":1,"insert":true,"visible":true,"color":"#f9d8f3","thickness":100,"diameter":1,"type":0,"notes":"","rgb":{"r":249,"g":216,"b":243}},{"id":5,"name":"Natural Cotton 60/2 Warp","stretch":1,"insert":true,"visible":true,"color":"#edede4","thickness":100,"diameter":1,"type":0,"notes":"","rgb":{"r":237,"g":237,"b":228}}],"indexed_image_data":[]}